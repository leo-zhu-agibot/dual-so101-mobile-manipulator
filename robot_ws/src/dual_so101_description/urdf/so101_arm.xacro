<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Primitive collision model with SO101-Nexus-compatible joint names and limits. -->
  <xacro:macro name="arm_link" params="name length radius mass color">
    <link name="${name}">
      <visual>
        <origin xyz="${length / 2.0} 0 0" rpy="0 ${pi / 2.0} 0"/>
        <geometry><cylinder radius="${radius}" length="${length}"/></geometry>
        <material name="${color}"/>
      </visual>
      <collision>
        <origin xyz="${length / 2.0} 0 0" rpy="0 ${pi / 2.0} 0"/>
        <geometry><cylinder radius="${radius}" length="${length}"/></geometry>
      </collision>
      <inertial>
        <origin xyz="${length / 2.0} 0 0"/>
        <mass value="${mass}"/>
        <inertia ixx="0.00010" ixy="0" ixz="0" iyy="0.00030" iyz="0" izz="0.00030"/>
      </inertial>
    </link>
  </xacro:macro>

  <xacro:macro name="so101_arm" params="prefix parent xyz rpy">
    <link name="${prefix}base_link">
      <visual><geometry><cylinder radius="0.045" length="0.065"/></geometry><material name="dark"/></visual>
      <collision><geometry><cylinder radius="0.045" length="0.065"/></geometry></collision>
      <inertial><mass value="0.147"/><inertia ixx="0.00014" ixy="0" ixz="0" iyy="0.00014" iyz="0" izz="0.00013"/></inertial>
    </link>
    <joint name="${prefix}mount_joint" type="fixed">
      <parent link="${parent}"/><child link="${prefix}base_link"/><origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>

    <xacro:arm_link name="${prefix}shoulder_link" length="0.060" radius="0.035" mass="0.100" color="yellow"/>
    <joint name="${prefix}shoulder_pan" type="revolute">
      <parent link="${prefix}base_link"/><child link="${prefix}shoulder_link"/>
      <origin xyz="0 0 0.055"/><axis xyz="0 0 1"/>
      <limit lower="-1.91986" upper="1.91986" effort="10" velocity="1.5"/>
    </joint>

    <xacro:arm_link name="${prefix}upper_arm_link" length="0.120" radius="0.028" mass="0.103" color="yellow"/>
    <joint name="${prefix}shoulder_lift" type="revolute">
      <parent link="${prefix}shoulder_link"/><child link="${prefix}upper_arm_link"/>
      <origin xyz="0.055 0 0"/><axis xyz="0 1 0"/>
      <limit lower="-1.74533" upper="1.74533" effort="10" velocity="1.5"/>
    </joint>

    <xacro:arm_link name="${prefix}lower_arm_link" length="0.120" radius="0.025" mass="0.104" color="yellow"/>
    <joint name="${prefix}elbow_flex" type="revolute">
      <parent link="${prefix}upper_arm_link"/><child link="${prefix}lower_arm_link"/>
      <origin xyz="0.120 0 0"/><axis xyz="0 1 0"/>
      <limit lower="-1.69" upper="1.69" effort="10" velocity="1.5"/>
    </joint>

    <xacro:arm_link name="${prefix}wrist_link" length="0.075" radius="0.022" mass="0.079" color="dark"/>
    <joint name="${prefix}wrist_flex" type="revolute">
      <parent link="${prefix}lower_arm_link"/><child link="${prefix}wrist_link"/>
      <origin xyz="0.120 0 0"/><axis xyz="0 1 0"/>
      <limit lower="-1.65806" upper="1.65806" effort="10" velocity="2.0"/>
    </joint>

    <link name="${prefix}gripper_link">
      <visual><geometry><box size="0.075 0.055 0.035"/></geometry><material name="yellow"/></visual>
      <collision><geometry><box size="0.075 0.055 0.035"/></geometry></collision>
      <inertial><mass value="0.087"/><inertia ixx="0.00004" ixy="0" ixz="0" iyy="0.00004" iyz="0" izz="0.00004"/></inertial>
    </link>
    <joint name="${prefix}wrist_roll" type="revolute">
      <parent link="${prefix}wrist_link"/><child link="${prefix}gripper_link"/>
      <origin xyz="0.075 0 0"/><axis xyz="1 0 0"/>
      <limit lower="-2.74385" upper="2.84121" effort="10" velocity="2.0"/>
    </joint>

    <link name="${prefix}moving_jaw_link">
      <visual><origin xyz="0.035 0 0"/><geometry><box size="0.070 0.012 0.018"/></geometry><material name="dark"/></visual>
      <collision><origin xyz="0.035 0 0"/><geometry><box size="0.070 0.012 0.018"/></geometry></collision>
      <inertial><mass value="0.025"/><inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/></inertial>
    </link>
    <joint name="${prefix}gripper" type="revolute">
      <parent link="${prefix}gripper_link"/><child link="${prefix}moving_jaw_link"/>
      <origin xyz="0.025 0.025 0"/><axis xyz="0 0 1"/>
      <limit lower="-0.174533" upper="1.74533" effort="10" velocity="2.0"/>
    </joint>

    <link name="${prefix}tcp_link"/>
    <joint name="${prefix}tcp_joint" type="fixed">
      <parent link="${prefix}gripper_link"/><child link="${prefix}tcp_link"/><origin xyz="0.085 0 0"/>
    </joint>
  </xacro:macro>
</robot>

