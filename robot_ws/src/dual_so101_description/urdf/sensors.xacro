<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="sensor_suite" params="parent">
    <link name="sensor_mast_link">
      <visual><origin xyz="0 0 0.18"/><geometry><cylinder radius="0.018" length="0.36"/></geometry><material name="dark"/></visual>
      <collision><origin xyz="0 0 0.18"/><geometry><cylinder radius="0.018" length="0.36"/></geometry></collision>
      <inertial><mass value="0.25"/><inertia ixx="0.003" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.0002"/></inertial>
    </link>
    <joint name="sensor_mast_joint" type="fixed"><parent link="${parent}"/><child link="sensor_mast_link"/><origin xyz="0.10 0 0.24"/></joint>

    <link name="head_rgbd_link">
      <visual><geometry><box size="0.090 0.030 0.025"/></geometry><material name="sensor_blue"/></visual>
      <collision><geometry><box size="0.090 0.030 0.025"/></geometry></collision>
      <inertial><mass value="0.08"/><inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00005"/></inertial>
    </link>
    <joint name="head_rgbd_joint" type="fixed"><parent link="sensor_mast_link"/><child link="head_rgbd_link"/><origin xyz="0.025 0 0.35"/></joint>
    <link name="head_rgbd_color_optical_frame"/>
    <joint name="head_rgbd_color_optical_joint" type="fixed"><parent link="head_rgbd_link"/><child link="head_rgbd_color_optical_frame"/><origin rpy="-1.570796 0 -1.570796"/></joint>
    <link name="head_rgbd_depth_optical_frame"/>
    <joint name="head_rgbd_depth_optical_joint" type="fixed"><parent link="head_rgbd_link"/><child link="head_rgbd_depth_optical_frame"/><origin xyz="0 -0.015 0" rpy="-1.570796 0 -1.570796"/></joint>

    <link name="lidar_link">
      <visual><geometry><cylinder radius="0.045" length="0.055"/></geometry><material name="sensor_blue"/></visual>
      <collision><geometry><cylinder radius="0.045" length="0.055"/></geometry></collision>
      <inertial><mass value="0.12"/><inertia ixx="0.00006" ixy="0" ixz="0" iyy="0.00006" iyz="0" izz="0.00010"/></inertial>
    </link>
    <joint name="lidar_joint" type="fixed"><parent link="${parent}"/><child link="lidar_link"/><origin xyz="-0.10 0 0.26"/></joint>

    <link name="imu_link"><inertial><mass value="0.01"/><inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/></inertial></link>
    <joint name="imu_joint" type="fixed"><parent link="${parent}"/><child link="imu_link"/><origin xyz="0 0 0.12"/></joint>
  </xacro:macro>
</robot>

