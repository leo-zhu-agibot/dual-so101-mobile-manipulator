<?xml version="1.0"?>
<robot name="dual_so101_mobile">
  <group name="left_arm"><chain base_link="left_base_link" tip_link="left_tcp_link"/></group>
  <group name="right_arm"><chain base_link="right_base_link" tip_link="right_tcp_link"/></group>
  <group name="dual_arms"><group name="left_arm"/><group name="right_arm"/></group>
  <group name="left_gripper"><joint name="left_gripper"/></group>
  <group name="right_gripper"><joint name="right_gripper"/></group>
  <end_effector name="left_ee" parent_link="left_tcp_link" group="left_gripper" parent_group="left_arm"/>
  <end_effector name="right_ee" parent_link="right_tcp_link" group="right_gripper" parent_group="right_arm"/>
  <group_state name="ready" group="left_arm"><joint name="left_shoulder_pan" value="0"/><joint name="left_shoulder_lift" value="-0.6"/><joint name="left_elbow_flex" value="1.0"/><joint name="left_wrist_flex" value="-0.4"/><joint name="left_wrist_roll" value="0"/><joint name="left_gripper" value="0.2"/></group_state>
  <group_state name="ready" group="right_arm"><joint name="right_shoulder_pan" value="0"/><joint name="right_shoulder_lift" value="-0.6"/><joint name="right_elbow_flex" value="1.0"/><joint name="right_wrist_flex" value="-0.4"/><joint name="right_wrist_roll" value="0"/><joint name="right_gripper" value="0.2"/></group_state>
  <disable_collisions link1="base_link" link2="torso_link" reason="Adjacent"/>
  <disable_collisions link1="left_base_link" link2="torso_link" reason="Adjacent"/>
  <disable_collisions link1="right_base_link" link2="torso_link" reason="Adjacent"/>
</robot>

